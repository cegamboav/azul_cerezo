// AZUL CEREZO — schema físico para revisión.
// No incluye migraciones, seed ni código de aplicación.
//
// Fuera de este archivo, a propósito: Invoice, InvoiceLine, Payment,
// sales tax, depósito, saldo, portal, cuenta de trabajador y pasarela.
//
// Visit.companyId es obligatorio y entra en la FK compuesta
// (companyId, serviceId) → Service(companyId, id).
//
// Service.quoteId es @unique a propósito en el MVP: una Quote aceptada
// genera como máximo un Service. Varios Service pueden tener quoteId null.
//
// Property.addressId es @unique a propósito en el MVP: una propiedad,
// una dirección, sin compartir Address entre propiedades.
//
// Prisma solo permite que un escalar participe en una @relation.
// Por eso companyId se usa en una sola relación por modelo:
//   - raíz de empresa → Company(id)
//   - hija de un agregado → (companyId, parentId) del padre
// La primera migración SQL debe añadir, además del SQL de Prisma,
// los índices parciales y las FKs compuestas que Prisma no puede expresar.
// No hace falta un CHECK de leadId/clientId: esa regla vive en la aplicación.
//
// ---------------------------------------------------------------------------
// Validación solo de aplicación, dentro de la transacción que escribe
// ---------------------------------------------------------------------------
// - QuoteRequest: lead con client null, client con lead null, o ambos en la
//   conversión. Nunca los dos vacíos. Sin CHECK en la base.
// - QuoteRequest.propertyId solo si hay clientId, y esa Property pertenece
//   a ese Client y a la misma empresa.
// - Enviar Quote solo con permiso quotes.send, desde IN_REVIEW, y con
//   PropertyAssessment DONE o WAIVED cuando requiresAssessment es true.
// - Al pasar una Quote a ACCEPTED, las hermanas en DRAFT, IN_REVIEW o SENT
//   de la misma QuoteRequest pasan a SUPERSEDED con closureReason SUPERSEDED.
// - Service recurrente: la primera Visit nace INITIAL y las siguientes
//   MAINTENANCE. Tras gapResetDays la visita nace MAINTENANCE y solo recibe
//   kindSuggestion INITIAL. Aceptar o descartar la sugerencia es otra acción.
// - ChecklistRun se crea al preparar la Visit, copiando la plantilla activa
//   de su visitKind. Como máximo una corrida; puede no existir antes.
// - Completar una Visit exige las fotos de requiredPhotoKinds si photosRequired.
// - Cancelación: horas hasta scheduledDate + windowStart en la zona de la
//   empresa. Porcentajes leídos de CancellationPolicyTier. Política apagada
//   → porcentaje calculado 0, salvo excepción. No se guarda un monto.
// - windowEnd posterior a windowStart. Porcentajes entre 0 y 100.
// - Buffer de 45 minutos: aviso, no bloqueo.
// - El companyId escrito coincide con el del token.
// - Conversión de Lead: se crea Client.sourceLeadId. No hay un segundo
//   puntero Lead.clientId, para que los dos no puedan divergir.
//
// ---------------------------------------------------------------------------
// Primera migración SQL — índices parciales (Prisma no los modela)
// ---------------------------------------------------------------------------
// CREATE UNIQUE INDEX "Quote_one_accepted_per_request"
//   ON "Quote" ("quoteRequestId")
//   WHERE "status" = 'ACCEPTED';
//
// CREATE UNIQUE INDEX "Contact_one_primary_per_client"
//   ON "Contact" ("clientId")
//   WHERE "isPrimary" = true;
//
// CREATE UNIQUE INDEX "ChecklistTemplate_one_active_per_kind"
//   ON "ChecklistTemplate" ("companyId", "visitKind")
//   WHERE "isActive" = true;
//
// ---------------------------------------------------------------------------
// Primera migración SQL — FKs que Prisma no puede declarar
// Cada tabla hija cuyo companyId ya está usado en otra @relation necesita
// también la FK directa a Company. Los padres opcionales o el segundo padre
// obligatorio necesitan la FK compuesta (companyId, parentId).
// ON DELETE RESTRICT ON UPDATE CASCADE, salvo las dos compuestas opcionales
// que acompañan un SET NULL de Prisma. Esas usan SET NULL solo de la
// columna nullable: anular también companyId violaría NOT NULL.
// Requiere PostgreSQL 15 o superior.
// ---------------------------------------------------------------------------
// ALTER TABLE "RolePermission" ADD CONSTRAINT "RolePermission_company_fkey"
//   FOREIGN KEY ("companyId") REFERENCES "Company"("id");
// ALTER TABLE "Membership" ADD CONSTRAINT "Membership_company_fkey"
//   FOREIGN KEY ("companyId") REFERENCES "Company"("id");
// ALTER TABLE "CancellationPolicyTier" ADD CONSTRAINT "CancellationPolicyTier_company_fkey"
//   FOREIGN KEY ("companyId") REFERENCES "Company"("id");
// ALTER TABLE "Contact" ADD CONSTRAINT "Contact_company_fkey"
//   FOREIGN KEY ("companyId") REFERENCES "Company"("id");
// ALTER TABLE "Property" ADD CONSTRAINT "Property_company_fkey"
//   FOREIGN KEY ("companyId") REFERENCES "Company"("id");
// ALTER TABLE "Property" ADD CONSTRAINT "Property_address_company_fkey"
//   FOREIGN KEY ("companyId", "addressId") REFERENCES "Address"("companyId", "id");
// ALTER TABLE "QuoteRequest" ADD CONSTRAINT "QuoteRequest_lead_company_fkey"
//   FOREIGN KEY ("companyId", "leadId") REFERENCES "Lead"("companyId", "id");
// ALTER TABLE "QuoteRequest" ADD CONSTRAINT "QuoteRequest_client_company_fkey"
//   FOREIGN KEY ("companyId", "clientId") REFERENCES "Client"("companyId", "id");
// ALTER TABLE "QuoteRequest" ADD CONSTRAINT "QuoteRequest_property_company_fkey"
//   FOREIGN KEY ("companyId", "propertyId") REFERENCES "Property"("companyId", "id");
// ALTER TABLE "PropertyAssessment" ADD CONSTRAINT "PropertyAssessment_company_fkey"
//   FOREIGN KEY ("companyId") REFERENCES "Company"("id");
// ALTER TABLE "PropertyAssessment" ADD CONSTRAINT "PropertyAssessment_worker_company_fkey"
//   FOREIGN KEY ("companyId", "workerId") REFERENCES "Worker"("companyId", "id")
//   ON DELETE SET NULL ("workerId") ON UPDATE CASCADE;
// ALTER TABLE "Quote" ADD CONSTRAINT "Quote_company_fkey"
//   FOREIGN KEY ("companyId") REFERENCES "Company"("id");
// ALTER TABLE "QuoteLine" ADD CONSTRAINT "QuoteLine_company_fkey"
//   FOREIGN KEY ("companyId") REFERENCES "Company"("id");
// ALTER TABLE "Service" ADD CONSTRAINT "Service_client_company_fkey"
