{
  "name": "@azul/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.23.3"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm run build --workspace @azul/database && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "npm run typecheck --workspace @azul/database && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@azul/database": "0.1.0",
    "cors": "^2.8.5",
    "dotenv": "17.4.2",
    "express": "^4.21.2",
    "helmet": "^8.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.19.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
