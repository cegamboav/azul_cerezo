    },
    "node_modules/@azul/database": {
      "resolved": "packages/database",
      "link": true
    },
    "node_modules/@azul/web": {
      "resolved": "apps/web",
      "link": true
    },
    "packages/database": {
      "name": "@azul/database"
    }
  }
