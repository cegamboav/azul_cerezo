{
  "name": "azul-cerezo",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "azul-cerezo",
      "workspaces": [
        "apps/web",
        "apps/api",
        "packages/database"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "apps/api": {
